{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",

    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf .)",
      "Bash(rm -rf ..*)",

      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main *)",
      "Bash(git push origin master *)",
      "Bash(git push origin main)",
      "Bash(git push origin master)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd *)",
      "Bash(git clean -fx *)",
      "Bash(git merge main *)",
      "Bash(git merge master *)",
      "Bash(git branch -D main *)",
      "Bash(git branch -D master *)",
      "Bash(git branch -D main)",
      "Bash(git branch -D master)",

      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(doas *)",
      "Bash(chmod 777 *)",
      "Bash(chown *)",

      "Bash(ssh *)",
      "Bash(scp *)",

      "Bash(brew uninstall *)",
      "Bash(apt *)",
      "Bash(apt-get *)",
      "Bash(npm install -g *)",
      "Bash(npx -g *)",

      "Bash(kill -9 *)",
      "Bash(killall *)",
      "Bash(pkill *)",
      "Bash(shutdown *)",
      "Bash(reboot *)",
      "Bash(launchctl *)",
      "Bash(systemctl *)",

      "Read(./.env.production*)",
      "Read(./secrets/**)",
      "Read(**/*secret*)",
      "Read(**/*secrets.json)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.netrc)",

      "Edit(./.env.production*)"
    ],

    "ask": [
      "Bash(rm -rf *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(kubectl delete *)",
      "Bash(kubectl apply *)",

      "Edit(./.claude/settings.json)",
      "Edit(./.claude/settings.local.json)"
    ],

    "allow": [
      "Bash(*)",
      "Read",
      "Edit",
      "Write",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Skill(*)",
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__plugin_context7_context7__query-docs",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs"
    ]
  },

  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "BASH_MAX_TIMEOUT_MS": "600000"
  }
}
